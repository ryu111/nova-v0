{
  "$schema": "../ClaimSpec.schema.json",
  "claimspec_version": "0.2.0",
  "claim_id": "claimspec.language.effect-delivery-conditional",
  "revision": 1,
  "supersedes": null,
  "statement": "effect_delivery 與 stimulus 裡的外部效果原語互為條件：用了效果原語卻沒有交付契約是 EFFECT_DELIVERY_REQUIRED，非效果 claim 卻帶著契約是 EFFECT_DELIVERY_FORBIDDEN。v1 只認 AT_LEAST_ONCE_IDEMPOTENT 與 AT_MOST_ONCE，宣告 EXACTLY_ONCE 是宣告一件做不到的事，回專屬的 UNSUPPORTED_DELIVERY_SEMANTICS——它與「該不該帶契約」是兩種不同的錯，順序被釘住：語意先判。",
  "sources": [
    {"source_id": "plan.01.task.6", "kind": "PLAN_TASK", "locator": "docs/計畫/01-可執行保證語言.md#task-6"},
    {"source_id": "plan.11.task.1", "kind": "PLAN_TASK", "locator": "docs/計畫/11-外部效果與後端更新.md#task-1"}
  ],
  "primitive_catalog": {"catalog_id": "claimspec-loader.v1", "digest": null},
  "subject": {"contract": "claimspec-loader.v1", "operation": "load", "binding_slot": "claimspec-loader.in-process"},
  "parameters": {"effect_contract_schema": "規格/介面/效果契約.schema.json", "allowed_semantics": ["AT_LEAST_ONCE_IDEMPOTENT", "AT_MOST_ONCE"]},
  "setup": [],
  "stimulus": [{"primitive": "claimspec.load", "arguments": {"bytes": "$SUBJECT_BYTES"}}],
  "observations": [{"observation_id": "code", "source": "STIMULUS_RESULT", "path": "code", "type": "STRING"}],
  "judge": {
    "all_of": [
      {"predicate_id": "effect_primitive_requires_contract", "operator": "NOT_EQUALS", "left": {"observation": "code"}, "right": {"const": "EFFECT_DELIVERY_REQUIRED"}},
      {"predicate_id": "non_effect_claim_forbids_contract", "operator": "NOT_EQUALS", "left": {"observation": "code"}, "right": {"const": "EFFECT_DELIVERY_FORBIDDEN"}},
      {"predicate_id": "only_supported_semantics_admitted", "operator": "NOT_EQUALS", "left": {"observation": "code"}, "right": {"const": "UNSUPPORTED_DELIVERY_SEMANTICS"}},
      {"predicate_id": "verdict_is_ok", "operator": "EQUALS", "left": {"observation": "code"}, "right": {"const": "OK"}}
    ]
  },
  "controls": {
    "positive": [{"control_id": "lawful-effect-claim", "subject_binding": "EFFECT_CLAIM_FIXTURE", "expected_terminal": "ACCEPT"}],
    "negative": [
      {"control_id": "effect-primitive-without-contract", "faulty_subject": "驗收/保證規格語言/測_meta_schema.py::最小_claim+{stimulus:effect.send,effect_delivery:null}", "expected_terminal": "CLAIM_REJECTED", "must_fail_exactly": ["effect_primitive_requires_contract"]},
      {"control_id": "contract-on-non-effect-claim", "faulty_subject": "驗收/保證規格語言/測_meta_schema.py::最小_claim+{effect_delivery:有效_effect_contract}", "expected_terminal": "CLAIM_REJECTED", "must_fail_exactly": ["non_effect_claim_forbids_contract"]},
      {"control_id": "exactly-once-declared", "faulty_subject": "驗收/保證規格語言/測_meta_schema.py::最小_claim+{effect_delivery.semantics:EXACTLY_ONCE}", "expected_terminal": "CLAIM_REJECTED", "must_fail_exactly": ["only_supported_semantics_admitted"]}
    ]
  },
  "run_limits": {"wall_ms": 60000, "max_output_bytes": 1048576},
  "isolation": "COOPERATIVE_PROCESS",
  "effect_delivery": null,
  "evidence": {"retain": ["code", "pointer"], "record_kind": "CLAIMSPEC_ADMISSION_VERDICT"},
  "feedback": {"to_candidate": "NONE"},
  "cleanup": []
}
