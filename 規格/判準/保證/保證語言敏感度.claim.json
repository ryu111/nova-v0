        "left": {
          "observation": "code"
        },
        "right": {
          "const": "NEGATIVE_NOT_DIRECT_RED"
        }
      },
      {
        "predicate_id": "negative_red_matches_must_fail_exactly",
        "operator": "NOT_EQUALS",
        "left": {
          "observation": "code"
        },
        "right": {
          "const": "NEGATIVE_RED_ON_WRONG_PREDICATE"
        }
      },
      {
        "predicate_id": "independent_result_is_not_negative_success",
        "operator": "NOT_EQUALS",
        "left": {
          "observation": "code"
        },
        "right": {
          "const": "INDEPENDENT_RESULT_COUNTED_AS_SUCCESS"
        }
      },
      {
        "predicate_id": "verdict_is_ok",
        "operator": "EQUALS",
        "left": {
          "observation": "code"
        },
        "right": {
          "const": "OK"
        }
      }
    ]
  },
  "controls": {
