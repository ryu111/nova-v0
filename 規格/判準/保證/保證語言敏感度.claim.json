{
  "$schema": "../../語言/ClaimSpec.schema.json",
  "claimspec_version": "0.2.0",
  "claim_id": "claimspec.controls.direct-red-preserved",
  "revision": 1,
  "supersedes": null,
  "statement": "三色矩陣的每一色都必須各自成立：actual 必須 ACCEPT、每個正控必須 ACCEPT、每個負控必須直接紅（CLAIM_REJECTED）且 failed_predicates 恰等於它宣告的 must_fail_exactly。外層 meta-test 綠代表內層的負控真的紅過——外層綠而內層沒紅過等於什麼都沒驗到。UNBOUND_SUBJECT、UNSUPPORTED_ISOLATION、HARNESS_ERROR、HARNESS_LIMIT 四種獨立結果一律不算負控成立：subject 自己爆掉不是抓到錯，是根本沒驗到。判定不看比例也不看多數，任一格不對就不通過。",
  "sources": [
    {
      "source_id": "plan.01.task.8",
      "kind": "PLAN_TASK",
      "locator": "docs/計畫/01-可執行保證語言.md#task-8"
    },
    {
      "source_id": "plan.01.independent-results",
      "kind": "PLAN_CONSTRAINT",
      "locator": "docs/計畫/01-可執行保證語言.md#L19"
    },
    {
